NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — never expose with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VOTE_IP_HASH_SALT=generate-a-long-random-string

# Vote rate limiting (Upstash direct or Vercel KV integration)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cloudflare Turnstile (vote CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry error tracking (org: versusmatch, project: javascript-nextjs)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=versusmatch
SENTRY_PROJECT=javascript-nextjs

# Admin moderation at /admin/login
ADMIN_SECRET=

# Resend report notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
REPORT_NOTIFY_EMAIL=
