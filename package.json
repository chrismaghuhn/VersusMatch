    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.184.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "sharp": "^0.34.5",
