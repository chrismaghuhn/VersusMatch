    "test:party-modifiers": "node --experimental-strip-types scripts/test-party-modifiers.mjs",
    "test:caption-fields": "node scripts/test-caption-fields.mjs",
    "test:caption-rich": "node --experimental-strip-types scripts/test-caption-rich.mjs",
    "test:caption-layout": "node --experimental-strip-types scripts/test-caption-layout.mjs",
    "test:party-guess-author": "node --experimental-strip-types --test scripts/test-party-guess-author.mjs",
    "test:party-reveal-theatre": "node --experimental-strip-types --test scripts/test-party-reveal-theatre.mjs",
    "test:party-lobby-settings": "node --experimental-strip-types --test scripts/test-party-lobby-settings.mjs",
