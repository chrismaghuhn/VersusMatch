{
  "name": "versus-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed:battles": "node scripts/seed-battles.mjs",
    "seo:list-urls": "node scripts/list-index-urls.mjs",
