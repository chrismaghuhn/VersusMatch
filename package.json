    "test:board-brawl-movement": "node --import ./scripts/resolve-ts-alias.mjs --experimental-strip-types --test scripts/test-board-brawl-movement.mjs",
    "test:board-brawl-tile-effects": "node --import ./scripts/resolve-ts-alias.mjs --experimental-strip-types --test scripts/test-board-brawl-tile-effects.mjs",
    "test:board-brawl-win-condition": "node --import ./scripts/resolve-ts-alias.mjs --experimental-strip-types --test scripts/test-board-brawl-win-condition.mjs",
    "test:board-brawl-layout-3d": "node --import ./scripts/resolve-ts-alias.mjs --experimental-strip-types --test scripts/test-board-brawl-layout-3d.mjs",
    "test:board-brawl-board-map": "node --import ./scripts/resolve-ts-alias.mjs --experimental-strip-types --test scripts/test-board-brawl-board-map.mjs",
    "test:board-brawl-minigame-engine": "node --import ./scripts/resolve-ts-alias.mjs --experimental-strip-types --test scripts/test-board-brawl-minigame-engine.mjs",
    "test:board-brawl": "npm run test:board-brawl-dice && npm run test:board-brawl-movement && npm run test:board-brawl-tile-effects && npm run test:board-brawl-win-condition && npm run test:board-brawl-layout-3d && npm run test:board-brawl-board-map && npm run test:board-brawl-minigame-engine",
    "test:board-brawl-e2e": "node --import ./scripts/resolve-ts-alias.mjs --experimental-strip-types scripts/test-board-brawl-e2e.mjs"
  },
  "dependencies": {
